# ── Notion Integration ────────────────────────────────────────────────────────
#
# REQUIRED. Your Notion internal integration token.
# How to create one:
#   1. Go to https://www.notion.so/my-integrations
#   2. Click "New integration"
#   3. Name it "KLG AI OS", associate with your KLG workspace
#   4. Copy the "Internal Integration Token" (starts with ntn_ or secret_)
#   5. IMPORTANT: Go to each Notion database you want the app to access,
#      click the "..." menu → "Add connections" → select "KLG AI OS".
#      Without this step the API returns 404 even with a valid token.
NOTION_TOKEN=

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
#
# Primary model for all legal reasoning, skill execution, and production work.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model selection (default: claude-opus-4-7 for production, claude-sonnet-4-6 for dev)
ANTHROPIC_MODEL=claude-opus-4-7

# ── OpenAI (ChatGPT) ──────────────────────────────────────────────────────────
#
# Used for braiding: parallel independent review on flagged queries.
# https://platform.openai.com/
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o

# ── Alfred Routing Layer ──────────────────────────────────────────────────────
#
# Port the routing layer listens on locally.
PORT=3000

# Path to the skills directory (relative to repo root).
SKILLS_DIR=./skills

# Braiding: set to true to fire parallel Claude + ChatGPT calls on flagged queries.
BRAIDING_ENABLED=true

# ── Slack (Alfred Quick-Query Bot) ────────────────────────────────────────────
#
# Slack bot token for the #alfred-quick-query integration.
# https://api.slack.com/apps
SLACK_BOT_TOKEN=

SLACK_SIGNING_SECRET=

# ── GitHub (Skills Source) ────────────────────────────────────────────────────
#
# Optional: if the routing layer pulls skill files directly from GitHub
# rather than the local filesystem, set these.
GITHUB_TOKEN=
GITHUB_REPO=edwyn128/klg-ai-os
GITHUB_SKILLS_PATH=skills
