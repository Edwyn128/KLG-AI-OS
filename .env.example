# =============================================================================
# KLG AI OS — Environment Variables Template
# =============================================================================
#
# HOW TO USE THIS FILE:
#   1. Copy this file to ".env" in the same folder:
#        cp .env.example .env
#   2. Fill in every value marked REQUIRED.
#   3. Never commit the real .env to git — it contains secrets.
#      The .gitignore already excludes it.
#
# WHERE TO FIND EACH VALUE is explained in the comment above each variable.
# =============================================================================


# ── AI API Keys ───────────────────────────────────────────────────────────────

# REQUIRED. Your Anthropic API key. Alfred (the inward-facing assistant)
# runs on Claude. Get this from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL. Only needed if you want Claude to hand off to ChatGPT for
# Deep Research sessions. Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...


# ── Notion Integration ────────────────────────────────────────────────────────

# REQUIRED. Your Notion internal integration token.
# How to create one:
#   1. Go to https://www.notion.so/my-integrations
#   2. Click "New integration"
#   3. Name it "KLG AI OS", associate with your KLG workspace
#   4. Copy the "Internal Integration Token" (starts with ntn_ or secret_)
#   5. IMPORTANT: Go to each Notion database you want the app to access,
#      click the "..." menu → "Add connections" → select "KLG AI OS".
#      Without this step the API returns 404 even with a valid token.
NOTION_TOKEN=ntn_...

# REQUIRED. The IDs of the four Notion databases the app reads and writes.
# How to find a database ID:
#   1. Open the database in Notion (full page view, not inline)
#   2. Look at the URL: https://www.notion.so/workspace/TITLE-XXXXXXXXXXXXXXXX
#   3. The ID is the last part after the final dash — 32 hex characters
#   4. Format it as: XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX (with dashes)
#      OR paste the raw 32-char string — both work with the SDK.
NOTION_PROJECTS_DB_ID=
NOTION_WATCH_LIST_DB_ID=
NOTION_ISSUES_DB_ID=
NOTION_CONTACTS_DB_ID=


# ── Slack ─────────────────────────────────────────────────────────────────────

# OPTIONAL. Required only if you want background agents to post to Slack.
# How to create a Slack bot:
#   1. Go to https://api.slack.com/apps → "Create New App" → "From scratch"
#   2. Name it "KLG AI OS", select your workspace
#   3. Go to "OAuth & Permissions" → add these Bot Token Scopes:
#        chat:write       (post messages)
#        channels:read    (list public channels)
#        groups:read      (list private channels the bot is in)
#   4. Click "Install to Workspace" → copy the "Bot User OAuth Token"
SLACK_BOT_TOKEN=xoxb-...

# The Slack channel where weekly agenda and hygiene alerts are posted.
# Must include the # prefix. The bot must be invited to this channel.
SLACK_CASE_MANAGEMENT_CHANNEL=#case-management

# Slack Signing Secret — verifies that webhook calls came from Slack.
# api.slack.com/apps → your app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=

# Channel Alfred listens in (bot must be invited)
SLACK_ALFRED_CHANNEL=#alfred


# ── SharePoint / Microsoft Graph ──────────────────────────────────────────────
# Required for Alfred to search KLG's SharePoint document library.
# 1. Register an app in Azure Portal → Azure AD → App registrations
# 2. Grant Microsoft Graph permissions: Sites.Read.All, Files.Read.All
# 3. Create a client secret under Certificates & secrets
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=


# ── Application Settings ──────────────────────────────────────────────────────

# Set to true during local development to get detailed error traces in the
# browser. NEVER set to true in production — it leaks internal details.
DEBUG=false

# The port FastAPI listens on. 8000 is the default. Change if something
# else is already using 8000 on your machine.
APP_PORT=8000


# ── Model Selection ───────────────────────────────────────────────────────────
# These control which Claude model Alfred and Bloodhound use.
# claude-sonnet-4-6 is the recommended default: fast, highly capable, cost-effective.
# Switch to claude-opus-4-7 for the most demanding tasks (costs more per token).
ALFRED_MODEL=claude-sonnet-4-6
BLOODHOUND_MODEL=claude-sonnet-4-6
